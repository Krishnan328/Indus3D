# Copy to .env and fill in what applies. Every value below has a working
# default in config/settings.py — you only need to set what you're actually
# changing. Nothing in here is required for --sim mode to run.

# ── Moonraker / Klipper ───────────────────────────────────────────────────
# MOONRAKER_HOST=127.0.0.1
# MOONRAKER_PORT=7125

# ── Webcam ─────────────────────────────────────────────────────────────────
# Only set this if your camera setup isn't the standard Mainsail/Crowsnest
# path (http://MOONRAKER_HOST/webcam/?action=stream)
# WEBCAM_STREAM_URL=

# ── Flask API ──────────────────────────────────────────────────────────────
# FLASK_HOST=0.0.0.0
# FLASK_PORT=5001
# FLASK_DEBUG=false

# CORS_ORIGINS=*

# ── Storage paths ────────────────────────────────────────────────────────
# DB_PATH=db/flight_record.db
# TIMELAPSE_DIR=data/timelapse

# ── Simulation (only used with --sim) ───────────────────────────────────
# SIM_MODE=false
# SIM_SHAPE=benchy
# SIM_LAYERS=30

# ── Telemetry tick rate ───────────────────────────────────────────────────
# Default 10Hz assumes a Pi 5. On a 1GB Pi or Creality mainboard, consider
# lowering this — every tick does a Moonraker poll, 3 digital twin model
# updates, a WebSocket push, and a SQLite log entry.
# TWIN_TICK_HZ=10

# ── Input-shaper baseline ────────────────────────────────────────────────
# y_resonance_hz, bed_mass_g, and y_shaper_type live in
# config/indus_overrides.cfg. Use the Shaper Tuner in the Digital Twin page
# to update them safely after a Klipper SHAPER_CALIBRATE run.

# ── Filament ───────────────────────────────────────────────────────────────
# DEFAULT_FILAMENT=PLA

# ── Notifications — optional, configure any/all/none ───────────────────
# Discord: Server Settings -> Integrations -> Webhooks -> New Webhook
# DISCORD_WEBHOOK_URL=

# Telegram: message @BotFather to create a bot and get a token, then
# message your bot once and check
# https://api.telegram.org/bot<TOKEN>/getUpdates for your chat_id
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=

# Critical alerts (thermal runaway) always notify if a channel above is
# configured. Warn-level alerts (lag, under/over-extrusion) are opt-in.
# NOTIFY_ON_WARN=false

# ── Alert thresholds ─────────────────────────────────────────────────────
# 0 means "use the value from the loaded printer profile" — set a nonzero
# value here only to override it.
# LAG_WARN_MM=0
# STRESS_WARN=0
# EXT_HEAT_CYCLES_WARN=0
# BED_HEAT_CYCLES_WARN=0

# ── PZEM-004T Power Monitor ──────────────────────────────────────────────
# USB-serial device path. Use by-id path for stability across reboots:
#   ls /dev/serial/by-id/
# Leave empty to disable — the Power Delivery card shows "not connected".
# PZEM_SERIAL_PORT=/dev/serial/by-id/usb-FTDI_FT232R_USB_UART_XXXXXXXX-if00-port0
# PZEM_SERIAL_BAUD=9600
# PZEM_MODBUS_ADDR=1

# ── Authentication ─────────────────────────────────────────────────────────
# Set a password to require login. When empty, auth is disabled entirely.
# For anything beyond local testing, set this.
# INDUS3D_PASSWORD=

# ── Disk Space Monitoring ─────────────────────────────────────────────
# Warn/critical thresholds for free disk space (GB).
# Raspberry Pi SD cards fill up fast with timelapses and snapshots.
# DISK_WARN_GB=2.0
# DISK_CRITICAL_GB=0.5
# DISK_CHECK_PATH=         # empty = backend directory partition
# DISK_CHECK_INTERVAL_S=60 # how often to poll (seconds)

# ── Not in .env ──────────────────────────────────────────────────────────
# Behavior settings (not secrets/paths) live in
# backend/config/indus_overrides.cfg instead: thermal-runaway power cutoff,
# timelapse mode/interval/fps, alert thresholds from the profile side. See
# that file's comments and docs/DEVELOPMENT.md.
